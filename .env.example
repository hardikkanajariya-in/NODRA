# Required for app + automatic schema sync on pnpm dev / pnpm build
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Set to 1 in CI when no database is available (skips drizzle-kit push)
# SKIP_DB_SYNC=1

SESSION_SECRET=generate-a-long-random-string

# Optional: username that can open /users and admin APIs (unset = disabled)
# SUPERVISOR_USERNAME=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

NEXT_PUBLIC_APP_URL=http://localhost:3000
